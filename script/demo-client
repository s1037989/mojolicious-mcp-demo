#!/usr/bin/env perl
use Mojo::Base -strict, -signatures;
use FindBin;
use lib "$FindBin::Bin/../lib";
use Getopt::Long qw(GetOptions);
use MCP::Client;
use MCP::Constants qw(META_LOG_LEVEL);
use MCPDemo::Config;
use Mojo::File qw(path);
use Mojo::JSON qw(encode_json true);

my ($profile, $url, $token_file, $approve, $release) = ('reader', 'http://127.0.0.1:3000/mcp', undef, 0, 'v1.2.3');
GetOptions('profile=s' => \$profile, 'url=s' => \$url, 'token-file=s' => \$token_file,
  'approve!' => \$approve, 'release=s' => \$release) or die "Invalid options\n";
my $command = shift(@ARGV) // 'tour';
die "Invalid profile\n" unless $profile =~ /\A(?:reader|writer|admin)\z/;
$token_file //= MCPDemo::Config::root()->child('var', "$profile.token");
my $token = path($token_file)->slurp;
$token =~ s/\s+\z//;
my $client = MCP::Client->new(url => $url, headers => {Authorization => "Bearer $token"},
  capabilities => {elicitation => {form => {}}});
sub show ($label, $data) { say "$label\n" . encode_json($data) . "\n" }
$client->on(notification => sub ($c, $message) { show('Notification', $message) });

if ($command eq 'tour') {
  show('Discovery', $client->discover);
  show('Tools', $client->list_tools);
  show('Prompts', $client->list_prompts);
  show('Resources', $client->list_resources);
  show('Caller', $client->call_tool('whoami'));
  show('Text', $client->call_tool('echo', {message => 'Hello from a Perl MCP client'}));
  show('Expected error', $client->call_tool('divide', {numerator => 5, denominator => 0}));
  show('Structured result', $client->call_tool('perl_version'));
  for my $kind (qw(text error image audio link)) {
    show("Result: $kind", $client->call_tool('result_demo', {kind => $kind}));
  }
  show('User prompt', $client->get_prompt('explain_module', {module => 'Mojo::UserAgent'}));
  show('Assistant prompt', $client->get_prompt('mentor'));
  show('Cached text resource', $client->read_resource('demo:///handbook'));
  show('Binary resource', $client->read_resource('demo:///pixel.png'));
  show('Private caller resource', $client->read_resource('demo:///me'));
} elsif ($command eq 'auth') {
  show('Caller', $client->call_tool('whoami'));
  show('Visible tools', $client->list_tools);
  for my $name (qw(publish_preview admin_status)) {
    my $result = eval { $client->call_tool($name, $name eq 'publish_preview' ? {release => $release} : {}) };
    if ($@) { say "Denied $name: $@" } else { show($name, $result) }
  }
} elsif ($command eq 'progress') {
  my $request = $client->build_request('tools/call', {name => 'count_steps', arguments => {steps => 10},
    _meta => {progressToken => 'demo-counter', META_LOG_LEVEL() => 'info'}});
  show('Final counter response', $client->send_request($request));
} elsif ($command eq 'confirm') {
  my $first = $client->call_tool('publish_preview', {release => $release});
  show('Confirmation requested', $first);
  if ($approve && ($first->{resultType} // '') eq 'input_required') {
    show('Confirmed simulation', $client->call_tool('publish_preview', {release => $release}, {
      request_state => $first->{requestState}, input_responses => {confirm => {action => 'accept', content => {ok => true}}}
    }));
  } else { say 'Pass --approve to explicitly approve this simulated operation.' }
} elsif ($command eq 'listen') {
  say 'Listening. In another terminal run demo-client --profile admin announce. Ctrl-C stops listening.';
  $client->listen({toolsListChanged => true}, sub ($message) { show('Subscription', $message); return 1 });
} elsif ($command eq 'announce') {
  show('Announcement', $client->call_tool('announce_tools'));
} else {
  die "Commands: tour, auth, progress, confirm, listen, announce\n";
}
